source "https://rubygems.org"

# Usar a gem "github-pages" (em vez de pedir uma versão do Jekyll direto)
# é o jeito oficial recomendado pelo GitHub: ela já trava automaticamente
# a mesma versão do Jekyll e dos plugins que o build do GitHub Pages usa
# de verdade, evitando esse erro de "can't satisfy your Gemfile's
# dependencies" que aconteceu antes (o Gemfile pedia Jekyll 4.4, mas o
# GitHub Pages roda Jekyll 3.10 por baixo dos panos).
gem "github-pages", group: :jekyll_plugins
